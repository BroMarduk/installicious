# Runtime state — generated by installicious as it runs.
status/
state/
backup/
logs/

# Editor / tooling — local-only.
.vscode/
.claude/

# Personal config overrides — *.override files hold per-user secrets and
# customizations (e.g. overrides/weewx.override with Wunderground
# credentials). They're intentionally out of git so the framework's
# default overrides/*.conf templates stay clean and reviewable.
*.override
