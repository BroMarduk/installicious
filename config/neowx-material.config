# config/neowx-material.config
#
# Defaults for feature-neowx-material (the NeoWX Material WeeWX skin —
# https://github.com/seehase/neowx-material). The editable keys
# (NEOWX_LANG / NEOWX_LOCALE / NEOWX_HTML_ROOT) surface on the in-menu
# Edit Configuration screen via the feature's II_EDITABLE_CONFIG;
# NEOWX_EXTENSION_URL is read by the feature but intentionally NOT
# editable — it's a project-level pin, not a per-Pi setting.

# Skin display language. One of the 11 codes the skin ships:
#   ca de en es fi fr it nl pl se sk
# Written to weewx.conf under [StdReport][[neowx-material]] as `lang`.
NEOWX_LANG="en"

# System locale WeeWX should run under so the skin renders dates and
# times in the expected format, e.g. "en_US.UTF-8" or "de_DE.UTF-8".
# When non-empty, feature-neowx-material writes a systemd drop-in at
# /etc/systemd/system/weewx.service.d/neowx-locale.conf containing
#   [Service]
#   Environment="LANG=<this>"
# (the drop-in is the clean equivalent of the README's "edit
# weewx.service" step — it survives package updates).
#
# The locale must already be GENERATED on the system. feature-locale
# handles that for the system locale; if you need a different one just
# for WeeWX, generate it first (`sudo dpkg-reconfigure locales`). If the
# locale isn't present, feature-neowx-material logs a warning and still
# writes the drop-in — WeeWX will fall back to C until the locale exists.
# Empty = no drop-in; WeeWX inherits whatever LANG the system has.
NEOWX_LOCALE=""

# Where the skin writes its generated HTML. Defaults to the same
# directory the rest of the weewx role serves from (WEEWX_WEB_DIR in
# config/weewx.config). NOTE: if the stock Seasons report is still
# enabled it ALSO writes here — disable it via overrides/weewx.conf
#   [StdReport]
#       [[SeasonsReport]]
#           enable = false
# if you want NeoWX Material to own the directory cleanly.
NEOWX_HTML_ROOT="/var/www/html/weewx"

# The extension archive feature-neowx-material installs via
# `weectl extension install` (weewx 5) / `wee_extension --install`
# (weewx 4). Defaults to the master branch of seehase's actively-
# maintained fork. Pin to a release tag for reproducible installs, e.g.
#   https://github.com/seehase/neowx-material/archive/refs/tags/vX.Y.Z.zip
# NEOWX_EXTENSION_URL="https://github.com/seehase/neowx-material/archive/refs/heads/master.zip"
NEOWX_EXTENSION_URL="weectl extension install https://github.com/BroMarduk/neowx-material/archive/refs/heads/feature/custom-chart-date-formats.zip"
