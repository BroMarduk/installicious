RCONF_GPU_MEM_SPLIT_LITE_4096=64             # Memory GPU Split for 4 GB LITE OS 
RCONF_GPU_MEM_SPLIT_LITE_8192=64             # Memory GPU Split for 8 GB LITE OS 
RCONF_GPU_MEM_SPLIT_256=64                   # Memory GPU Split for 256 MB OS   
RCONF_GPU_MEM_SPLIT_512=64                   # Memory GPU Split for 512 MB OS  
RCONF_GPU_MEM_SPLIT_1024=128                 # Memory GPU Split for 1 GB OS 
RCONF_GPU_MEM_SPLIT_2048=128                 # Memory GPU Split for 2 GB OS 
