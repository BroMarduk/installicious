# rconf.config — defaults for install-rconf.sh
#
# Values that surface in the menu config editor (II_EDITABLE_CONFIG): the
# user can override them per-run via the editor; their picks persist to
# $PATH_STATE/menu-config.sh and survive future runs. Values that DON'T
# surface in the editor are still read from this file by install-rconf.sh
# at runtime — edit this file directly to change them.
#
# Pi-model and OS-version applicability is enforced by
# installers/install-rconf.choices.sh: a key whose _applies_<KEY> /
# _choices_<KEY> helper rejects this system is hidden from the menu AND
# its config value is silently ignored at install time. So setting
# RCONF_USB_CURRENT_UNLIMITED on a Pi 4 is a no-op (Pi 5 only).
#
# Imager-handled inputs (timezone, Wi-Fi country, hostname, SSH enable,
# initial user/password, RPi Connect) are NOT in this file — set them
# during flash via the Pi Imager wizard.

# ---- Localisation -----------------------------------------------------------
RCONF_LOCALE="en_US.UTF-8"                  # extra locale to generate (free-form; the system locale set by the Imager stays as-is)
RCONF_KEYBOARD_LAYOUT="us"                  # xkb keyboard layout code; Imager may have set this differently for the country, override here
RCONF_KEYBOARD_MODEL="pc105"                # xkb keyboard model

# ---- Boot behavior ----------------------------------------------------------
RCONF_BOOT_TARGET="console"                 # "console" or "desktop" — Lite always uses console (the choices helper enforces this)
RCONF_BOOT_AUTOLOGIN="true"                 # auto-login as the default user on the boot target

# ---- Console / display ------------------------------------------------------
RCONF_BLANKING="false"                      # disable console screen blanking when "true" (do_blanking 0/1 inverted: false=enable=raspi-config arg 0)

# ---- Hardware interfaces ----------------------------------------------------
RCONF_INTERFACE_SPI="false"                 # SPI bus
RCONF_INTERFACE_I2C="false"                 # I2C bus
RCONF_INTERFACE_ONEWIRE="false"             # 1-Wire (DS18B20 etc.)
RCONF_INTERFACE_SERIAL_CONSOLE="false"      # serial console on the UART
RCONF_INTERFACE_SERIAL_HW_UART="false"      # hardware UART (independent of console toggle)

# ---- Storage ----------------------------------------------------------------
RCONF_OVERLAYFS="false"                     # read-only root via overlayfs (reboot required)

# ---- Boot device priority (Pi 4/5 only) -------------------------------------
RCONF_BOOT_ORDER="0xf41"                    # 0xf41=SD,USB,Net  0xf14=USB,SD,Net  0xf21=Net,SD,USB
RCONF_BOOTLOADER_VERSION="default"          # "default" (stable) or "latest" (newest features)

# ---- Performance / power ----------------------------------------------------
RCONF_OVERCLOCK="default"                   # Pi 1/2 only on Bookworm+ (None/High/Modest/etc.); ignored on newer Pis
RCONF_FAN_ENABLE="false"                    # Pi 4 only — enable raspi-config GPIO fan management
RCONF_FAN_GPIO=14                           # Pi 4 only — GPIO pin for fan PWM
RCONF_FAN_TEMP=80                           # Pi 4 only — fan-on threshold (°C)
RCONF_POWEROFF_ON_HALT="true"               # Pi 4/5 only — full power-off on shutdown vs halt-only
RCONF_USB_CURRENT_UNLIMITED="false"         # Pi 5 only — lift the 600 mA USB cap (required for SSDs)
