# config/ram-logging.config — values for feature-ram-logging.
#
# Blank values fall back to per-Pi smart defaults from
# features/feature-ram-logging.choices.sh — the editor display shows
# what the helper picked so you can see the value before installing.
# Set an explicit value below only if you want to override the
# auto-tune for a specific Pi.

RAMLOG_PROFILE=""                # blank → zram-both (compressed RAM, hourly + on-shutdown sync)
RAMLOG_SIZE_MB=""                # blank → 256 (>=3.5 GB) / 128 (1.8-3.5 GB) / 48 (<1.8 GB)
RAMLOG_COMPRESSION_ALGO=""       # blank → zstd on Pi 4/5, lz4 on Pi 3/Zero 2 (CPU-class auto)
                                  #   ignored when RAMLOG_PROFILE is a tmpfs- variant
