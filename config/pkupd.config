# config/pkupd.config — defaults for feature-pkupd (Update & Upgrade Packages).
#
# Editable keys (PKUPD_UPGRADE_MODE, PKUPD_SKIP_WINDOW_MIN, PKUPD_AUTOREMOVE)
# surface on the in-menu Edit Configuration screen via the feature's
# II_EDITABLE_CONFIG.

# How deep the upgrade goes:
#   dist-upgrade  apt-get dist-upgrade — upgrades everything AND installs
#                 new packages / removes obsolete ones as needed. This is
#                 what pulls a new-ABI kernel (a brand-new linux-image-*
#                 package). The default — a fresh Pi expects to be brought
#                 fully current. "full-upgrade" is accepted as an alias:
#                 `apt full-upgrade` and `apt-get dist-upgrade` are the
#                 identical operation.
#   upgrade       apt-get upgrade — upgrades installed packages in place
#                 only; never installs a new package or removes one, so a
#                 new kernel stays "kept back" until you run a deliberate
#                 dist-upgrade by hand. Pick this if you don't want
#                 installicious surprising you with a kernel jump.
PKUPD_UPGRADE_MODE="dist-upgrade"

# Re-run skip window, in minutes. After a pkupd upgrade SUCCEEDS, a
# subsequent installicious run within this many minutes skips the
# update/upgrade/autoremove steps (they're recorded as still-fresh). A
# failed upgrade records no timestamp, so a retry always re-runs.
# Set to 0 to disable the skip — pkupd then upgrades on every run.
PKUPD_SKIP_WINDOW_MIN="60"

# Run `apt-get autoremove --purge` after the upgrade to clear packages no
# longer needed (orphaned libraries, superseded kernels). "true" (default)
# or "false" to skip the autoremove step. Independent of the upgrade depth
# above.
PKUPD_AUTOREMOVE="true"
