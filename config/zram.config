ZRAM_PERCENT_OF_RAM=50                       # Zram swap size as percent of physical RAM. 50 is widely recommended.
ZRAM_COMPRESSION_ALGO="zstd"                 # lz4 (low CPU, less compression), zstd (balanced), lz4hc (slow, high compression).
ZRAM_SWAP_PRIORITY=100                       # Higher than disk swap so the kernel uses zram first.
ZRAM_DISABLE_DPHYS_SWAPFILE=true             # Disable the older /var/swap SD-card swapfile if present (recommended).
