# config/zram.config — values for feature-zram.
#
# The first three values default to blank — feature-zram.choices.sh
# computes a smart default based on Pi model + RAM tier (lifted from
# scripts/ramdisk-logging.sh). Set an explicit value below to override.
# Whatever appears in the edit-config screen is what the installer
# applies; if you don't edit a row, the smart default is used at install
# time but NOT persisted (so a future hardware swap auto-re-tunes).

ZRAM_PERCENT_OF_RAM=""                       # Zram swap size as percent of physical RAM.
                                              #   blank → auto: 50 if ≥1.8 GB RAM, 40 if <1.8 GB
ZRAM_COMPRESSION_ALGO=""                     # zstd (Pi 4/5: better ratio) or lz4 (Pi 3/Zero 2: lighter CPU).
                                              #   blank → auto-pick based on /proc/device-tree/model
ZRAM_SWAP_PRIORITY=""                        # Higher than disk swap so the kernel uses zram first.
                                              #   blank → 100 (recommended; rarely needs changing)
ZRAM_DISABLE_DPHYS_SWAPFILE=true             # Disable the older /var/swap SD-card swapfile if present (recommended).
