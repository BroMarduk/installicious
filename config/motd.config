MOTD_NAME="dannet"                           # Name of the MOTD to be created
MOTD_SMALL_SIZE=79                           # Width threshold (cols) below which motd-small.sh is shown
MOTD_IP_URL="https://api.ipify.org"          # URL used for getting external IP address
MOTD_WEATHER_LOC_CODE="1945_PC"              # AccuWeather location key (e.g. 1945_PC). Edit via the menu editor.
MOTD_WEATHER_API_KEY=""                      # AccuWeather API bearer token. REQUIRED for motd-weather; set via menu editor.