# installicious.config — top-level path & runtime configuration.
#
# Paths fall into two groups:
#
#   Checkout-local (relative): the source tree itself — installers, configs,
#   resources, scripts, tasks. Resolved against installicious.sh's working
#   directory at run time.
#
#   System-wide (absolute under /etc/installicious/): runtime state that
#   must persist across runs and survive a fresh wget+tar / git clone into
#   a different directory. menu-config.sh (your saved API keys, hostnames,
#   etc.), per-installer status files, queue state for reboot/resume,
#   backup snapshots used by --uninstall, and the append-only log all
#   live here.

# ---- Checkout-local (relative) ----
PATH_CONFIG="config"                                        # Default values per installer.
PATH_SCRIPTS="scripts"                                      # options.sh / resume.sh entry points.
PATH_INSTALLERS="installers"                                # The install-*.sh scripts themselves.
PATH_TASKS="tasks"                                          # Pi-role definitions (task-*.sh).
PATH_DEPENDENCIES="dependencies"                            # Legacy *-up.sh / *-down.sh helpers (mostly retired).
PATH_RESOURCES="resources"                                  # File templates rendered into /etc/* by installers.

# ---- System-wide (absolute, persistent across fresh extracts) ----
PATH_STATE="/etc/installicious/state"                       # menu-config.sh (user edits) + queue.sh (reboot/resume).
PATH_STATUS="/etc/installicious/status"                     # Per-installer .status files (skip-if-current ledger).
PATH_LOGS="/etc/installicious/logs"                         # Append-only installicious.log.
PATH_BACKUP="/etc/installicious/backup"                     # Snapshots taken before installer-modified files (used by --uninstall).

PATH_INSTALLICIOUS="/etc/installicious"                     # Conventional install root.
FILE_INSTALLICIOUS="installicious.sh"                       # Entry-point filename.
FILE_LOG_INSTALLICIOUS="installicious.log"                  # Log filename inside PATH_LOGS.
ACCEPTABLE_TIME_DELTA_SEC=3600                              # Apt cache TTL in seconds. Skips apt-get update if a refresh ran within this window.
UNINSTALL_DEPENDENCIES=""                                   # Dependencies to uninstall at end.
