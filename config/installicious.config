PATH_LOGS="logs"                                            # Path to logs directory   
PATH_CONFIG="config"                                        # Path to config directory
PATH_SCRIPTS="scripts"                                      # Path to scripts directory
PATH_INSTALLERS="installers"                                # Path to installers directory
PATH_TASKS="tasks"                                          # Path to tasks directory (Pi role definitions)
PATH_DEPENDENCIES="dependencies"                            # Path to dependencies directory
PATH_RESOURCES="resources"                                  # Path to resources directory
PATH_STATUS="status"                                        # Path to status directory
PATH_BACKUP="backup"                                        # Path to backups taken before installer-modified files; needed for --uninstall.
PATH_STATE="state"                                          # Path to the scheduler queue state directory (used for reboot/resume).
PATH_INSTALLICIOUS="/etc/installicious"                     # Path to installicious script
FILE_INSTALLICIOUS="installicious.sh"                       # File for installicious script
FILE_LOG_INSTALLICIOUS="installicious.log"                  # File name for log file
ACCEPTABLE_TIME_DELTA_SEC=3600                              # Apt cache TTL in seconds. Skips apt-get update if a refresh ran within this window.
UNINSTALL_DEPENDENCIES=""                                   # Dependencies to uninstall at end.
