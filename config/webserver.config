# config/webserver.config
#
# Common knobs surfaced by feature-webserver via II_EDITABLE_CONFIG.
# The chosen backend (apache / nginx / lighttpd / caddy) reads these
# values and applies them to its own native config file.

# Document root served by the chosen backend.
WEBSERVER_DOC_ROOT="/var/www/html"

# Server name / virtual host. Empty = backend uses the Pi's hostname
# at install time (resolved via _default_WEBSERVER_SERVER_NAME).
WEBSERVER_SERVER_NAME=""

# HTTP listen port. 80 is the conventional default; pick something
# else if another service is already bound there.
WEBSERVER_PORT="80"

# Email for Let's Encrypt registration. Only required when the
# webserver-ssl feature is selected; certbot uses it for renewal
# reminders and recovery. Leave blank otherwise.
WEBSERVER_SSL_EMAIL=""

# SSL challenge method (only used when webserver-ssl is selected):
#   "dns-cloudflare" (default) DNS-01 challenge via the Cloudflare API.
#                    Works while the proxy stays on (orange cloud);
#                    requires a CF API token in WEBSERVER_SSL_CF_TOKEN
#                    with Zone:DNS:Edit permission on the relevant zone.
#   "http"           HTTP-01 challenge via the backend's webroot.
#                    Needs port 80 reachable from Let's Encrypt. Fails
#                    when the domain is behind a proxy like Cloudflare
#                    that intercepts /.well-known/acme-challenge/ paths.
WEBSERVER_SSL_METHOD="dns-cloudflare"

# Cloudflare API token used by the dns-cloudflare challenge plugin.
# Only required when WEBSERVER_SSL_METHOD="dns-cloudflare". Create the
# token at https://dash.cloudflare.com/profile/api-tokens via the
# "Edit zone DNS" template, scoped to the zone hosting your domain.
# Stored at /etc/installicious/state/cloudflare.ini (mode 0600) for
# certbot to read.
WEBSERVER_SSL_CF_TOKEN=""

# What to do with plain HTTP traffic once SSL is configured.
# Used by feature-webserver-ssl for nginx / apache / lighttpd. (Caddy
# has its own equivalent knob CADDY_HTTP_POLICY below — Caddy ships
# its own ACME client, so the WEBSERVER_SSL_* knobs don't apply to it.)
#
#   "redirect-all"  (default) - any HTTP request, regardless of Host
#                   header, returns 301 to https://. LAN access by IP
#                   trips a cert-name warning because the cert is for
#                   WEBSERVER_SERVER_NAME, not the IP, but the redirect
#                   is consistent.
#   "redirect-name" - only requests whose Host header matches
#                   WEBSERVER_SERVER_NAME redirect to HTTPS. Other
#                   hosts (LAN IP, other names) serve plain HTTP.
#                   Friendlier for local diagnostics; matches what
#                   "certbot --redirect" produced before this knob.
#   "deny-http"     - close port 80 to everything except the Let's
#                   Encrypt challenge path (/.well-known/acme-
#                   challenge/) needed for renewal. LAN IP access
#                   gets no response. Strictest option.
#
# All policies leave /.well-known/acme-challenge/ reachable on :80 so
# certbot's HTTP-01 renewal path keeps working without manual
# intervention. (DNS-cloudflare renewals don't need :80 either way.)
WEBSERVER_SSL_HTTP_POLICY="redirect-all"

# Caddy-specific HTTP policy (feature-caddy only). Mirrors the three
# WEBSERVER_SSL_HTTP_POLICY values but plugs into Caddy's own built-in
# auto-HTTPS pipeline (no certbot involvement). Caddy always issues
# its own cert via the Let's Encrypt ACME client when CADDY_HTTP_POLICY
# implies HTTPS; CADDY_ACME_EMAIL below is the registration address.
#
#   "redirect-all"   (default) any HTTP request -> HTTPS
#   "redirect-name"  only Host==WEBSERVER_SERVER_NAME redirects;
#                    other Hosts keep plain HTTP (Caddy's default)
#   "deny-http"      :80 closes for everything except ACME challenge
CADDY_HTTP_POLICY="redirect-all"

# Email Caddy registers with Let's Encrypt for its built-in ACME
# client (renewal reminders + recovery). Required by feature-caddy
# when CADDY_HTTP_POLICY is set.
CADDY_ACME_EMAIL=""
