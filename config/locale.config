# config/locale.config — values for feature-locale.
#
# Any value left blank is SKIPPED — the system keeps whatever the RPi
# Imager (or earlier configuration) put in place. Set a value here only
# when you want feature-locale to overwrite the existing setting.

LOCALE_LANG="en_US.UTF-8"             # System locale; passed to raspi-config nonint do_change_locale.
LOCALE_TIMEZONE=""                     # e.g. "America/New_York"; blank preserves default.
LOCALE_KEYBOARD_LAYOUT="us"            # Country code for raspi-config do_configure_keyboard.
LOCALE_KEYBOARD_MODEL="pc104"          # Hardware model written to /etc/default/keyboard's XKBMODEL.
LOCALE_WIFI_COUNTRY=""                 # 2-letter ISO 3166 code (e.g. "US"); blank preserves default.
