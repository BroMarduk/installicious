# config/weewx.config
#
# Shared defaults for the weewx-* features. Editable keys are declared
# on each feature's II_EDITABLE_CONFIG so the menu editor surfaces them
# under the feature that owns the behavior.

# Document root the WeeWX reports are generated into. Both
# weewx-webroot (which points the active backend's default site here)
# and weewx-site-ramdisk (which mounts a tmpfs here and seeds a
# loading page) read this. Default matches what `apt install weewx`
# produces on Raspberry Pi OS.
WEEWX_WEB_DIR="/var/www/html/weewx"

# Size of the tmpfs mounted at WEEWX_WEB_DIR by weewx-site-ramdisk.
# WeeWX reports are small (HTML + a handful of PNGs); 128M is plenty.
WEEWX_TMPFS_SIZE="128M"

# Where weewx-database-ramdisk persists snapshots of the live DB.
# This is the mirror on the SD card; the live DB lives on the zram
# device at WEEWX_DB_DIR (default below).
WEEWX_DB_HDD_DIR="/var/lib/weewx.hdd"

# Live DB mount point (where weewx itself reads/writes). The
# weewx-database-ramdisk feature mounts a zram-backed ext4 here on
# boot and snapshots back to WEEWX_DB_HDD_DIR hourly + on shutdown.
WEEWX_DB_DIR="/var/lib/weewx"

# Snapshot retention. Each rotated snapshot is roughly the live DB
# size, so 5 * ~300M ~= 1.5 GB on the SD card for a typical install.
WEEWX_DB_ROTATIONS="5"

# Pin the zram device size manually (e.g. "1024M"). "AUTO" (or empty) =
# let the installer compute it at install time: 1.5x current DB, rounded
# up to 128M, floor 256M. Override when you know the DB is about to grow
# (you've added a long-running sensor / a new archive table / etc.) so
# the live device doesn't run out of space mid-cycle.
WEEWX_DB_ZRAM_SIZE="AUTO"
