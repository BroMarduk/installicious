# config/weewx.config
#
# Shared defaults for the weewx-* features. Editable keys are declared
# on each feature's II_EDITABLE_CONFIG so the menu editor surfaces them
# under the feature that owns the behavior.

# Document root the WeeWX reports are generated into. Both
# weewx-webroot (which points the active backend's default site here)
# and weewx-site-ramdisk (which mounts a tmpfs here and seeds a
# loading page) read this. Default matches what `apt install weewx`
# produces on Raspberry Pi OS.
WEEWX_WEB_DIR="/var/www/html/weewx"

# Size of the tmpfs mounted at WEEWX_WEB_DIR by weewx-site-ramdisk.
# WeeWX reports are small (HTML + a handful of PNGs); 128M is plenty.
WEEWX_TMPFS_SIZE="128M"

# Where weewx-database-ramdisk persists snapshots of the live DB.
# This is the mirror on the SD card; the live DB lives on the zram
# device at WEEWX_DB_DIR (default below).
WEEWX_DB_HDD_DIR="/var/lib/weewx.hdd"

# Live DB mount point (where weewx itself reads/writes). The
# weewx-database-ramdisk feature mounts a zram-backed ext4 here on
# boot and snapshots back to WEEWX_DB_HDD_DIR hourly + on shutdown.
WEEWX_DB_DIR="/var/lib/weewx"

# Snapshot retention. Each rotated snapshot is roughly the live DB
# size, so 5 * ~300M ~= 1.5 GB on the SD card for a typical install.
WEEWX_DB_ROTATIONS="5"

# Pin the zram device size manually (e.g. "1024M"). "AUTO" (or empty) =
# let the installer compute it at install time: 1.5x current DB, rounded
# up to 128M, floor 256M. Override when you know the DB is about to grow
# (you've added a long-running sensor / a new archive table / etc.) so
# the live device doesn't run out of space mid-cycle.
WEEWX_DB_ZRAM_SIZE="AUTO"

# ---------------------------------------------------------------------------
# WeeWX station setup (feature-weewx-setup)
# ---------------------------------------------------------------------------
# These are the install-critical, per-Pi-unique settings — surfaced on the
# in-menu Edit Configuration screen. feature-weewx-setup feeds them to
# `weectl station reconfigure` (weewx 5) / `wee_config --reconfigure`
# (weewx 4) right after the apt install, so the weewx package never has to
# prompt interactively. Everything else (report skins, uploaders, logging,
# driver-specific sections) goes in overrides/weewx.conf instead, to keep
# this list short.

# Human-readable station location, e.g. "Manchester, VT". Shows in the
# generated reports. Blank → weewx keeps its package default.
WEEWX_STATION_LOCATION=""

# Latitude / longitude in DECIMAL degrees. North and East are positive;
# South and West are negative (e.g. "-72.123"). Blank → package default.
WEEWX_LATITUDE=""
WEEWX_LONGITUDE=""

# Station altitude — a bare number; the unit is WEEWX_ALTITUDE_UNITS.
WEEWX_ALTITUDE=""
WEEWX_ALTITUDE_UNITS="foot"                  # foot | meter

# Hardware driver / station type. "Simulator" is weewx's built-in fake
# station — good for a first boot before real hardware is wired up.
# Common real values: Vantage, AcuRite, FineOffsetUSB, TE923, Ultimeter,
# WMR100, WMR300, WS1, WS23xx, WS28xx. (See `weectl device --help` for
# the full list on your install.)
WEEWX_STATION_TYPE="Simulator"

# Unit system for the generated reports: us | metric | metricwx.
WEEWX_UNITS="us"

# Publish this station to the public weewx.com station registry?
# "true" opts in (requires WEEWX_STATION_URL to be reachable). "false"
# keeps the station private — the safe default.
WEEWX_REGISTER_STATION="false"

# Public URL of the station's web page — only used (and only required)
# when WEEWX_REGISTER_STATION="true". Blank otherwise.
WEEWX_STATION_URL=""
